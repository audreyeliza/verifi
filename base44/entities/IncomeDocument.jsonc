{
  "type": "object",
  "name": "IncomeDocument",
  "description": "A pay stub uploaded by the household. The file itself stays in private storage; this row stores the file URI and the numbers they confirmed.",
  "properties": {
    "applicant": {
      "type": "string",
      "description": "Applicant record id"
    },
    "file_uri": {
      "type": "string",
      "description": "Private storage URI from UploadPrivateFile. Never store the file bytes here."
    },
    "employer": {
      "type": "string"
    },
    "gross_pay": {
      "type": "number",
      "description": "Gross pay for this pay period, before taxes"
    },
    "pay_frequency": {
      "type": "string",
      "enum": ["weekly", "biweekly", "semimonthly", "monthly"],
      "enumColors": ["blue", "purple", "yellow", "green"]
    },
    "pay_date": {
      "type": "string",
      "format": "date"
    },
    "monthly_equivalent": {
      "type": "number",
      "description": "Gross pay converted to a monthly amount"
    }
  },
  "required": ["applicant", "file_uri"],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
